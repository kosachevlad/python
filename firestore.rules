rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each work has one immutable vote document per anonymous Firebase UID.
    // Aggregation count() uses list permission; no personal data is stored.
    match /studentWorks/{workId}/votes/{uid} {
      allow list: if workId.matches('^[a-z0-9-]{1,100}$');
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.firebase.sign_in_provider == 'anonymous'
                    && workId.matches('^[a-z0-9-]{1,100}$')
                    && request.resource.data.keys().hasOnly(['createdAt'])
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // WARNING: Merge these rules with existing project rules before deploying
    // if you have other Firestore collections.
  }
}
